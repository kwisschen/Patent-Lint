+        # split a determiner (...发送所|述Y), and resuming at m.end() would then
+        # skip the reference a plain finditer used to reach.
+        inner = _EMBEDDED_DETERMINER_RE_CN.search(text, m.start("noun"), m.end() + 1)
+        pos = inner.start() if inner else m.end()

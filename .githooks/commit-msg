#!/bin/sh
# Commit-message check: a scrubbed reporter draft fragment (CJK or English)
# must not enter the public history through a commit message. Same scanner
# and hashes as tests/test_no_reporter_draft_fragments.py.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
exec python3 "$REPO_ROOT/tests/test_no_reporter_draft_fragments.py" "$1"
